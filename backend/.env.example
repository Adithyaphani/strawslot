# --- required in production ---
NODE_ENV=production
DATABASE_URL=postgres://strawslot:CHANGE_ME@postgres:5432/strawslot
JWT_SECRET=generate-with-openssl-rand-hex-32-at-least-32-chars
BOOTSTRAP_OFFICER_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# --- recommended ---
REDIS_URL=redis://redis:6379
CORS_ORIGINS=https://your-frontend.example
TRUST_PROXY=1
METRICS_TOKEN=CHANGE_ME
ACCESS_TOKEN_TTL_MIN=15
# --- process roles ---
RUN_WORKER_IN_API=false        # true only for single-process deployments
MIGRATE_ON_BOOT=false          # run `npm run migrate` as a job instead
DEMO_AUTO_RESEED=false
# --- optional integrations ---
FIRMS_MAP_KEY=
ANTHROPIC_API_KEY=
SMS_PROVIDER=console           # console | webhook | twilio
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
